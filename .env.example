# ---------------------------------------------------------------------------
# Public site URL — used to build Stripe/Vipps return URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ---------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3210/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Vipps ePayment — https://portal.vipps.no (test values live in the test portal)
# ---------------------------------------------------------------------------
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
# apitest.vipps.no for test, api.vipps.no for production
VIPPS_API_BASE=https://apitest.vipps.no
